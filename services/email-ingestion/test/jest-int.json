{
	"moduleFileExtensions": [
		"js",
		"json",
		"ts"
	],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".int-spec.ts$",
	"extensionsToTreatAsEsm": [
		".ts"
	],
	"transform": {
		"^.+\\.(t|j)s$": [
			"ts-jest",
			{
				"useESM": true
			}
		]
	},
	"moduleNameMapper": {
		"^(\\.{1,2}/.*)\\.js$": "$1"
	},
	"testTimeout": 20000
}