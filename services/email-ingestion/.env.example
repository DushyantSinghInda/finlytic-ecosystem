NODE_ENV=development
PORT=3002

JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem
JWT_ISSUER=finlytic-user-management
JWT_AUDIENCE=finlytic

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5434/email_db?schema=public
ENCRYPTION_KEY=<32 random bytes, base64 — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">

GOOGLE_CLIENT_ID=<your client id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your client secret>
GOOGLE_REDIRECT_URI=http://localhost:3002/oauth/gmail/callback
OAUTH_STATE_SECRET=<32 random bytes, base64 — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=finlytic-email
S3_ACCESS_KEY_ID=finlytic
S3_SECRET_ACCESS_KEY=finlytic_dev_secret

REDIS_HOST=localhost
REDIS_PORT=6380

ZOHO_CLIENT_ID=<your client id>
ZOHO_CLIENT_SECRET=<your client secret>
ZOHO_REDIRECT_URI=http://localhost:3002/oauth/zoho/callback
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
