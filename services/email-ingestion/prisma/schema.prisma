generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum MailProvider {
  GMAIL
  ZOHO

  @@map("mail_provider")
}

enum AccountStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISABLED

  @@map("account_status")
}

model MailAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  provider          MailProvider
  providerAccountId String       @map("provider_account_id")
  emailAddress      String       @map("email_address")

  status AccountStatus @default(ACTIVE)

  accessTokenEnc     String   @map("access_token_enc")
  accessTokenExpires DateTime @map("access_token_expires") @db.Timestamptz(3)
  refreshTokenEnc    String?  @map("refresh_token_enc")
  scopes             String[]

  syncCursor    String?   @map("sync_cursor")
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(3)
  lastSyncError String?   @map("last_sync_error")

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([status])
  @@map("mail_accounts")
}

model Message {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  providerMessageId String  @map("provider_message_id")
  providerThreadId  String? @map("provider_thread_id")

  subject     String?
  fromAddress String?  @map("from_address")
  fromName    String?  @map("from_name")
  toAddresses String[] @map("to_addresses")
  sentAt      DateTime @map("sent_at") @db.Timestamptz(3)

  snippet        String?
  labels         String[]
  sizeBytes      Int?     @map("size_bytes")
  hasAttachments Boolean  @default(false) @map("has_attachments")

  rawObjectKey String  @map("raw_object_key")
  bodyTextKey  String? @map("body_text_key")

  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)

  account MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerMessageId])
  @@index([accountId, sentAt])
  @@index([fromAddress])
  @@map("messages")
}
